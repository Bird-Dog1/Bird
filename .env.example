NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side aliases are also accepted by the app, but the NEXT_PUBLIC_ values
# are required anywhere Supabase is used from browser code.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key

# Required in production: used to generate absolute Supabase Auth callback URLs.
# Use your deployed app URL in production, for example https://bird-dog.example.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
